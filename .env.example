# ==============================================================================
# سامانه هوشمند مانیتورینگ رسانه شرکت ملی پخش فرآورده‌های نفتی ایران
# تنظیمات محیطی نسخه عملیاتی (Production Environment Variables)
# ==============================================================================

# محیط اجرا (production یا development)
NODE_ENV=production

# پورت اجرای وب‌سرور Express
PORT=3000

# دامنه یا آدرس مجاز جهت اتصال CORS (در محیط واقعی دامنه سایت یا IP سرور، مانند https://news.niopdc.ir)
CORS_ORIGIN="https://your-dashboard-domain.example"

# ------------------------------------------------------------------------------
# احراز هویت Supabase (کلیدهای عمومی؛ هرگز Service Role Key را اینجا قرار ندهید)
# مقدار SUPABASE_URL همان Project URL و SUPABASE_ANON_KEY کلید publishable/anon است.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# این دو مقدار هنگام build فرانت‌اند نیز باید در محیط build تعریف شوند.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# ------------------------------------------------------------------------------
# تنظیمات پایگاه داده (Database Configuration)
# ------------------------------------------------------------------------------
# ۱. برای PostgreSQL روی لینوکس (پیشنهاد شده برای Production):
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=niopdc_app"
# Use the direct Supabase database connection (not the transaction pooler) for Prisma schema sync.
#
# ۲. برای پایگاه داده داخل داکر (Docker Compose):
# DATABASE_URL="postgresql://niopdc_user:SecurePassword123@postgres:5432/niopdc_media?schema=public"
#
# ۳. برای فایل محلی SQLite (محیط تست و توسعه):
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------------------------
# هوش مصنوعی و کلیدهای دسترسی (AI & API Keys)
# ------------------------------------------------------------------------------
# کلید اختصاصی Google Gemini API جهت تحلیل محتوا، کشف شایعات و تولید بسته رسانه‌ای
GEMINI_API_KEY=""

# فعال یا غیرفعال‌سازی تحلیل خودکار هوش مصنوعی روی اخبار جدید (true یا false)
AI_ANALYSIS_ENABLED=true

# ------------------------------------------------------------------------------
# زمان‌بند و خزشگر خودکار (Background Media Scheduler)
# ------------------------------------------------------------------------------
# بازه زمانی پایش و خزش خودکار منابع بر حسب دقیقه (پیش‌فرض: ۱۰ دقیقه)
NEWS_POLL_INTERVAL_MINUTES=30

# آدرس پایه برنامه (اختیاری جهت لینک‌های ارجاعی)
APP_URL="http://localhost:3000"
